# ===== 大模型接口配置（可更换）=====

# 提供方预设：deepseek / openai / custom
# deepseek = DeepSeek 官方接口（国内直连，推荐）
# openai  = OpenAI 官方接口
# custom  = 任意 OpenAI 兼容接口，需同时设置 LLM_BASE_URL 和 LLM_MODEL
LLM_PROVIDER=deepseek

# API 密钥：留空时自动进入"模拟演示模式"（不消耗额度，用于开发测试）
LLM_API_KEY=

# 接口地址：一般无需修改；custom 时必填
LLM_BASE_URL=

# 模型名称：一般无需修改；custom 时可指定
LLM_MODEL=

# 运行模式：real=真实调用 / mock=模拟演示
LLM_MODE=mock

# 请求超时（秒）
LLM_TIMEOUT=60
